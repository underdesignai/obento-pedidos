# ==========================================
# OBENTO - CONFIGURACIÓN DEL SERVIDOR & BBDD
# ==========================================

# Puerto de la API backend
PORT=3001

# URL del frontend (para CORS y redirecciones de Stripe)
CLIENT_URL=http://localhost:3000

# Conexión a PostgreSQL Nativo (puedes usar DATABASE_URL o las variables PG*)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/obento_db
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=obento_db
PGPORT=5432

# Stripe (Pasarela de Pago Online)
# Claves de prueba de Stripe (Dashboard de Stripe -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
